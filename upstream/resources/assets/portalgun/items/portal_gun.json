{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "portalgun:item/portal_gun_inventory"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "entries": [
        {
          "threshold": 1.0,
          "model": {
            "type": "minecraft:special",
            "base": "portalgun:item/portal_gun_smooth_base",
            "model": {
              "type": "portalgun:portal_gun"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:special",
        "base": "portalgun:item/portal_gun_smooth_base",
        "model": {
          "type": "portalgun:portal_gun"
        }
      }
    }
  }
}
