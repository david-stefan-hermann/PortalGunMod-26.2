{
  "schemaVersion": 1,
  "id": "portalgun",
  "version": "${version}",

  "name": "Portal Gun",
  "description": "Portal Gun mod by ButterBoyRS, unofficial port to Minecraft 26.2",
  "authors": ["ButterBoyRS"],
  "contributors": ["David Stefan Hermann (26.2 port)"],
  "contact": {
    "homepage": "https://modrinth.com/mod/portalblaster",
    "sources": "https://github.com/david-stefan-hermann/PortalGunMod-26.2"
  },
  "license": "MIT",

  "environment": "*",

  "entrypoints": {
    "main": [
      "com.example.portalgun.PortalGunMod"
    ],
    "client": [
      "com.example.portalgun.client.PortalGunClient"
    ]
  },
  "mixins": [
    "portalgun.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.160.0",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
